# Veritabanı
DATABASE_URL="postgresql://kullanici:parola@sunucu:5432/irsaliye?schema=public"

# Oturum çerezini imzalar. En az 32 karakter, rastgele olmalı.
# Üretmek için: openssl rand -base64 48
OTURUM_ANAHTARI=""

# --- Belge depolama ---
# "yerel" (varsayılan) ya da "supabase".
# Vercel gibi sunucusuz ortamlarda disk kalıcı olmadığı için "supabase" kullanın.
DEPO="yerel"

# DEPO=yerel iken: dosyaların yazılacağı dizin
YUKLEME_DIZINI="./yuklemeler"

# DEPO=supabase iken gerekenler.
# SERVIS_ANAHTARI "service_role" anahtarıdır; yalnızca sunucuda kalmalı,
# tarayıcıya asla verilmemeli.
SUPABASE_URL=""
SUPABASE_SERVIS_ANAHTARI=""
SUPABASE_KOVA="belgeler"

# Tohum verisi için varsayılan parola (yalnızca ilk kurulumda)
TOHUM_PAROLA="degistir123"
