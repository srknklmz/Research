# --- Veritabanı ---
# Çalışma anı bağlantısı. Supabase'de "Connection pooling" (Transaction mode,
# port 6543) adresini kullanın ve sonuna ?pgbouncer=true ekleyin — sunucusuz
# ortamda her istek yeni bağlantı açtığı için havuz şart.
DATABASE_URL="postgresql://postgres.<proje>:<parola>@aws-0-<bolge>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Şema işlemleri (prisma db push / migrate) için doğrudan bağlantı, port 5432.
DIRECT_URL="postgresql://postgres:<parola>@db.<proje>.supabase.co:5432/postgres"

# --- Oturum ---
# Oturum çerezini imzalar. En az 32 karakter, rastgele olmalı.
# Üretmek için: openssl rand -base64 48
OTURUM_ANAHTARI=""

# --- Belge depolama ---
# "yerel" (varsayılan) ya da "supabase".
# Vercel gibi sunucusuz ortamlarda disk kalıcı olmadığı için "supabase" şart.
DEPO="supabase"

# DEPO=yerel iken: dosyaların yazılacağı dizin
YUKLEME_DIZINI="./yuklemeler"

# DEPO=supabase iken gerekenler.
# SERVIS_ANAHTARI "service_role" anahtarıdır; yalnızca sunucuda kalmalı,
# tarayıcıya asla verilmemeli.
SUPABASE_URL="https://<proje>.supabase.co"
SUPABASE_SERVIS_ANAHTARI=""
SUPABASE_KOVA="belgeler"

# Tohum verisi için varsayılan parola (yalnızca ilk kurulumda)
TOHUM_PAROLA="degistir123"
